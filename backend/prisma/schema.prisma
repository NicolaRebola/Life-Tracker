// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id    String @id @default(uuid())
  firebaseUid String  @unique @map("firebase_uid")
  email       String   @unique
  displayName String? @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  sessions Session[]
  events Event[]
  eventComments EventComment[]
  eventParticipants EventParticipant[]
  sentInvitations EventInvitation[] @relation("InvitedByUser")

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum EventStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EventInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EventInvitationChannel {
  EMAIL
}

enum MessageOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum MessageFailureKind {
  TRANSIENT
  PERMANENT
}

model Event {
  id      String    @id @default(uuid())
  fromDateTime   DateTime
  toDateTime   DateTime
  name   String
  description  String
  notes  String @default("")
  status EventStatus @default(TODO)
  userId   String
  deletedAt DateTime? @map("deleted_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags EventTag[]
  comments EventComment[]
  participants EventParticipant[]
  invitations EventInvitation[]

  @@index([userId, status])
  @@index([userId, fromDateTime])
  @@index([deletedAt])
  @@map("events")
}

model Tag {
  id String @id @default(uuid())
  name String @unique
  label String

  events EventTag[]

  @@map("tags")
}

model EventTag {
  eventId String @map("event_id")
  tagId   String @map("tag_id")
  
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([eventId, tagId])
  @@map("event_tags")
}

model EventParticipant {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  email       String
  displayName String?   @map("display_name")
  userId      String?   @map("user_id")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  revokedAt   DateTime? @map("revoked_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments EventComment[]
  sessions ParticipantSession[]

  @@unique([eventId, email])
  @@index([email])
  @@index([userId])
  @@map("event_participants")
}

model EventInvitation {
  id                 String                @id @default(uuid())
  eventId            String                @map("event_id")
  invitedEmail       String                @map("invited_email")
  invitedByUserId    String                @map("invited_by_user_id")
  channel            EventInvitationChannel
  status             EventInvitationStatus @default(PENDING)
  tokenHash          String                @unique @map("token_hash")
  expiresAt          DateTime              @map("expires_at")
  acceptedAt         DateTime?             @map("accepted_at")
  revokedAt          DateTime?             @map("revoked_at")
  deliveryFailedAt   DateTime?             @map("delivery_failed_at")
  lastDeliveryError  String?               @map("last_delivery_error")
  createdAt          DateTime              @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([eventId, invitedEmail, status])
  @@index([expiresAt])
  @@map("event_invitations")
}

model ParticipantSession {
  id            String    @id @default(uuid())
  participantId String    @map("participant_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([expiresAt])
  @@map("participant_sessions")
}

model MessageOutbox {
  id                String               @id @default(uuid())
  channel           String
  messageType       String               @map("message_type")
  payload           Json
  status            MessageOutboxStatus  @default(PENDING)
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(3) @map("max_attempts")
  failureKind       MessageFailureKind?  @map("failure_kind")
  providerMessageId String?              @map("provider_message_id")
  lastErrorCode     String?              @map("last_error_code")
  lastError         String?              @map("last_error")
  availableAt       DateTime             @default(now()) @map("available_at")
  processedAt       DateTime?            @map("processed_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("message_outbox")
}

model EventComment {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  userId        String?   @map("user_id")
  participantId String?   @map("participant_id")
  body          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant EventParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
  @@index([participantId])
  @@index([deletedAt])
  @@map("event_comments")
}